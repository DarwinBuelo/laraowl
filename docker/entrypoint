#!/bin/bash

set -euo pipefail

cd /var/www/html

main() {
    if [[ "${1:-}" == "bootstrap" ]]; then
        wait_for_db
        run_migrations
        optimize_app
        touch /tmp/app-ready
        echo "Application is ready."
        exit 0
    fi

    prepare_storage
    render_nginx

    # www-data workers (Horizon, the scheduler, Reverb) write container logs.
    chmod a+rw /dev/stdout /dev/stderr 2>/dev/null || true

    echo "Nginx is listening on 0.0.0.0:${PORT}."
    exec "$@"
}

prepare_storage() {
    echo "Preparing storage..."

    mkdir -p storage/app/public \
        storage/framework/cache/data \
        storage/framework/sessions \
        storage/framework/views \
        storage/logs \
        bootstrap/cache

    chown -R www-data:www-data storage bootstrap/cache
    chmod -R 775 storage bootstrap/cache

    php artisan storage:link --force --ansi
}

wait_for_db() {
    echo "Waiting for the database..."

    local attempts=0
    local output

    until output=$(php artisan migrate:status 2>&1) && grep -q -E '(Migration table not found|Migration name)' <<< "$output"; do
        attempts=$((attempts + 1))

        if (( attempts >= 60 )); then
            echo "Database is still unreachable after 60 seconds. Last error:"
            echo "$output"
            exit 1
        fi

        sleep 1
    done
}

run_migrations() {
    php artisan migrate --force --ansi
}

optimize_app() {
    php artisan optimize:clear --ansi
    php artisan optimize --ansi
    chown -R www-data:www-data bootstrap/cache storage
}

render_nginx() {
    local config_dir="/etc/nginx/http.d"

    if [[ ! -d "$config_dir" ]]; then
        config_dir="/etc/nginx/conf.d"
    fi

    mkdir -p "$config_dir"

    export PORT="${PORT:-8080}"

    if [[ -z "${APP_HOSTNAME:-}" ]]; then
        export APP_HOSTNAME="_"
        export WS_HOSTNAME="_"
    else
        export WS_HOSTNAME="ws.${APP_HOSTNAME}"
    fi

    echo "Serving HTTP on port ${PORT}."

    envsubst '${PORT} ${APP_HOSTNAME} ${WS_HOSTNAME}' \
        < /etc/nginx/templates/default.conf.template \
        > "${config_dir}/default.conf"

    nginx -t
}

main "$@"
